# Optional. If set, SnapSOL uses a Helius RPC endpoint for faster,
# more reliable mainnet reads. If unset, it falls back to the public
# Solana RPC (https://api.mainnet-beta.solana.com), which works with
# no key at all — just slower and rate-limited.
#
# Get a free key at https://www.helius.dev/ and paste ONLY the key here:
HELIUS_API_KEY=

# Optional override for the full RPC URL (takes precedence over the key).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
